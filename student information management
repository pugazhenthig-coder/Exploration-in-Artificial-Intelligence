students = {}

while True:
    print("\n1. Add  2. View  3. Search  4. Delete  5. Exit")
    choice = input("Enter your choice: ")

    if choice == "1":
        roll = input("Roll No: ")
        name = input("Name: ")
        dept = input("Department: ")
        students[roll] = {"Name": name, "Department": dept}
        print("Student added successfully.")

    elif choice == "2":
        for roll, data in students.items():
            print(f"Roll No: {roll} | Name: {data['Name']} | Department: {data['Department']}")

    elif choice == "3":
        roll = input("Roll No: ")
        print(students.get(roll, "Student not found."))

    elif choice == "4":
        roll = input("Roll No: ")
        if roll in students:
            del students[roll]
            print("Student deleted successfully.")
        else:
            print("Student not found.")

    elif choice == "5":
        print("Exiting...")
        break

    else:
        print("Invalid choice.")
